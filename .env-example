# Set to 1 to skip IPFS-dependent behavior during local development.
DISABLE_IPFS=1

# Run ingestion when the server starts.
INGEST_ON_BOOT=true

# Ingestion interval in milliseconds. 10800000 is 3 hours.
INGEST_INTERVAL_MS=10800000

# LLM provider configuration.
LLM_MODEL=gemma4:31b-cloud
LLM_API_URL=https://ollama.com/v1
# X API bearer token
X_API_BEARER_TOKEN=Bearer

